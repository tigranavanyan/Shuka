# Copy to .env for local overrides. In production set these as host secrets/env vars.
# Required in production (long random string, e.g. `openssl rand -hex 32`):
SESSION_SECRET=
# Where shuka.db, uploads/ and backups/ live. Must be a persistent disk in production.
DATA_DIR=./data
PORT=3000
NODE_ENV=development
# Number of daily backups to keep
BACKUP_KEEP=14
